{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p2p-desktop",
  "version": "0.1.0",
  "identifier": "com.p2p.aggregator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Sovereign Station",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../stage/p2p-aggregator.exe": "p2p-aggregator.exe",
      "../stage/p2p-daemon.exe": "p2p-daemon.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
